<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Pan and wordmark fit inside the Android 12+ 192dp safe circle. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/cookdex_launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/cookdex_splash</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:statusBarColor">@color/cookdex_launch_background</item>
        <item name="android:navigationBarColor">@color/cookdex_launch_background</item>
    </style>
</resources>
